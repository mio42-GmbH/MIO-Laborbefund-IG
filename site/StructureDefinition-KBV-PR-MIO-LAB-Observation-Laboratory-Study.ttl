     ] [
       fhir:id [ fhir:v "Observation.method.coding.version" ] ;
       fhir:path [ fhir:v "Observation.method.coding.version" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.method.coding.code" ] ;
       fhir:path [ fhir:v "Observation.method.coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.method.coding.display" ] ;
       fhir:path [ fhir:v "Observation.method.coding.display" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.method.coding.userSelected" ] ;
       fhir:path [ fhir:v "Observation.method.coding.userSelected" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.method.text" ] ;
       fhir:path [ fhir:v "Observation.method.text" ] ;
       fhir:definition [ fhir:v "Hier kann eine Freitext-Bezeichnung der Untersuchungsmethode notiert werden. Mögliche Verwendung:\n\n* als Freitextergänzung, wenn die Methode durch die Spezifikation Laboruntersuchung (LOINC® Code: METHOD) nicht ausreichend spezifisch codiert werden kann\n* ersatzweise, wenn zur Untersuchungsmethode auch kein passender SNOMED CT®-Code zugeordnet werden kann\n* als ergänzender, dem SNOMED CT®-Code entsprechender Freitext" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.specimen" ] ;
       fhir:path [ fhir:v "Observation.specimen" ] ;
       fhir:definition [ fhir:v "Eine Laboruntersuchung kann auf einer Primärprobe oder einer weiter verarbeiteten Probe (Sekundärprobe) basieren. Die Zuordnung einer Sekundärprobe zu einer Laboruntersuchung ist dann empfehlenswert, wenn durch die Probenvorbereitung im Labor eine relevante Veränderung des Untersuchungsmaterials erfolgt (z.B. Abtrennung Plasma).\n\nEin Beispiel für die Unterscheidung zwischen Primärprobe und Sekundärprobe: als Primärprobe erreicht eine Probenart = Vollblut das Labor. Durch Zentrifugieren im Labor entsteht eine Sekundärprobe mit Probenart = Serum. Die zu analysierende Substanz wird im Serum gemessen." ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Specimen|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Specimen|1.0.0-update>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.specimen.reference" ] ;
       fhir:path [ fhir:v "Observation.specimen.reference" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.specimen.type" ] ;
       fhir:path [ fhir:v "Observation.specimen.type" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.specimen.identifier" ] ;
       fhir:path [ fhir:v "Observation.specimen.identifier" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.specimen.display" ] ;
       fhir:path [ fhir:v "Observation.specimen.display" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.device" ] ;
       fhir:path [ fhir:v "Observation.device" ] ;
       fhir:short [ fhir:v "Laboranalysegerät" ] ;
       fhir:definition [ fhir:v "Hier wird das Gerät bzw. Medizinprodukt referenziert, mit dem die Laboruntersuchung durchgeführt wird." ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Device_Laboratory_Analyzer|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Device_Laboratory_Analyzer|1.0.0-update>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.device.reference" ] ;
       fhir:path [ fhir:v "Observation.device.reference" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.device.type" ] ;
       fhir:path [ fhir:v "Observation.device.type" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.device.identifier" ] ;
       fhir:path [ fhir:v "Observation.device.identifier" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.device.display" ] ;
       fhir:path [ fhir:v "Observation.device.display" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange" ] ;
       fhir:path [ fhir:v "Observation.referenceRange" ] ;
       fhir:definition [ fhir:v "Richtgrenzen oder Bewertungsgrenzen zu einer Laboruntersuchung\n\n* werden herangezogen für die Beurteilung und Einordnung von Messergebnissen\n* sind laborärztliche Entscheidungsgrenzen (mit ggf. juristischer Relevanz)\n* sind ärztliche Entscheidungshilfen im klinischen Allta\n\n\nDisclaimer: FHIR® definiert aktuell nur inklusive Richtgrenzen. Für die Praxistauglichkeit besteht aber die Anforderung, auch exklusive Richtgrenzen abbilden zu können. Diese Thematik wurde schon bei HL7® FHIR® platziert, es gibt aber noch keine abschließende Festlegung dazu. Im Informationsmodell sind beide Optionen bereits dargestellt, um diese Anforderung sichtbar zu machen." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "url" ]
         ] ) ;
         fhir:rules [ fhir:v "closed" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension" ] ;
       fhir:sliceName [ fhir:v "sourceReferenceRange" ] ;
       fhir:short [ fhir:v "Quelle der Richtgrenzen" ] ;
       fhir:definition [ fhir:v "Mögliche Angaben als Quelle für Richtgrenzen können sein:\n\n* Internationaler Standard\n* Nationaler Standard\n* Literatur\n* Gerätehersteller\n* Beipackzettel\n* Labor-intern\n* nicht angegeben\n\nZusätzlich zur Freitextangabe einer LDT-Information ist in FHIR® auch die Codierung möglich (optional)." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_Source_Reference_Range"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_Source_Reference_Range>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x]" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x]" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].coding" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].coding" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].coding.system" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].coding.system" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].coding.version" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].coding.version" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].coding.code" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].coding.code" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].coding.display" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].coding.display" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:sourceReferenceRange.value[x].text" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x].text" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:noLinearReferenceRange" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension" ] ;
       fhir:sliceName [ fhir:v "noLinearReferenceRange" ] ;
       fhir:short [ fhir:v "Kennzeichen Nicht-linearer Referenzbereich" ] ;
       fhir:definition [ fhir:v "Kennzeichnung, dass das numerische Ergebnis aus einem NICHT-LINEAREN Wertebereich stammt. Beispiele hierfür sind ganzzahlige Scores oder Titer-Reihen. Umgangssprachlich wird auch von sog. \"semiquantitativen\" Ergebnissen gesprochen. Seit LOINC® Version 2.76 ist das anhand des LOINC®-Codes offiziell definiert und ablesbar mit Scale = \"SemiQn\". Das Kennzeichen ist optional und wird vom messenden Labor gesetzt." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_No_Linear_Reference_Range"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_No_Linear_Reference_Range>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.extension:noLinearReferenceRange.value[x]" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.extension.value[x]" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.low" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.low" ] ;
       fhir:definition [ fhir:v "Die untere Richtgrenze ist eine quantitative Grenze. Datentyp und Einheit entsprechen denen beim quantitativen Messergebnis. Unter Eigenschaften sind mögliche Werte gelistet, die in dieses Feld hineinpassen könnten, beispielsweise ein Grenzwert aus dem LDT. Bei diesen Beispielen aus dem LDT gilt es zu beachten, dass die Grenzwerte nur für eine Richtgrenze vom Typ \"normal\" gelten.\n\nDisclaimer: FHIR® definiert aktuell nur inklusive Richtgrenzen. Für die Praxistauglichkeit besteht aber die Anforderung, auch exklusive Richtgrenzen abbilden zu können. Diese Thematik wurde schon bei HL7® FHIR® platziert, es gibt aber noch keine abschließende Festlegung dazu. Im Informationsmodell sind beide Optionen bereits dargestellt, um diese Anforderung sichtbar zu machen." ] ;
       fhir:pattern [
         a fhir:Quantity ;
         fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.low.value" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.low.value" ] ;
       fhir:definition [ fhir:v "Numerischer Wert für eine gemessene Größe, eine Zahl mit optionalen Dezimalstellen." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.low.unit" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.low.unit" ] ;
       fhir:definition [ fhir:v "Die Einheit leitet sich aus der Messgröße (gemessene Eigenschaft und Mengenmaß) ab. Ein Beispiel: Wenn die Messgröße \"Massekonzentration pro Volumen\" ist, kommen als Einheiten mg/dl oder g/dl in Frage. Nur UCUM-Einheiten sind zulässig.\n\nNicht immer werden Richtgrenzen mit Einheiten angegeben. Ein typisches Bespiel hierfür: zum Immunitätsnachweis aus einer Probe werden Verdünnungsreihen von 1:2, 1:4, 1:8, 1:16, 1:32 usw. hergestellt. Die Verdünnungen gibt man auf Zellkulturen, die dann mit einem Virus infiziert werden. Die höchste Verdünnungsstufe, bei der noch eine Infektion der Zellen vollständig verhindert wird, also noch ausreichend Antikörper vorhanden sind, wird als Titer angegeben. Dieser Titer wird ohne Einheiten angeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.low.system" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.low.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.low.code" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.low.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.high" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.high" ] ;
       fhir:definition [ fhir:v "Die obere Richtgrenze ist eine quantitative Grenze. Datentyp und Einheit entsprechen denen beim quantitativen Messergebnis. Unter Eigenschaften sind mögliche Werte gelistet, die in dieses Feld hineinpassen könnten, beispielsweise ein Grenzwert aus dem LDT. Bei diesen Beispielen aus dem LDT gilt es zu beachten, dass die Grenzwerte nur für eine Richtgrenze vom Typ \"normal\" gelten.\n\nDisclaimer: FHIR® definiert aktuell nur inklusive Richtgrenzen. Für die Praxistauglichkeit besteht aber die Anforderung, auch exklusive Richtgrenzen abbilden zu können. Diese Thematik wurde schon bei HL7® FHIR® platziert, es gibt aber noch keine abschließende Festlegung dazu. Im Informationsmodell sind beide Optionen bereits dargestellt, um diese Anforderung sichtbar zu machen." ] ;
       fhir:pattern [
         a fhir:Quantity ;
         fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.high.value" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.high.value" ] ;
       fhir:definition [ fhir:v "Numerischer Wert für eine gemessene Größe, eine Zahl mit optionalen Dezimalstellen." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.high.unit" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.high.unit" ] ;
       fhir:definition [ fhir:v "Die Einheit leitet sich aus der Messgröße (gemessene Eigenschaft und Mengenmaß) ab. Ein Beispiel: Wenn die Messgröße \"Massekonzentration pro Volumen\" ist, kommen als Einheiten mg/dl oder g/dl in Frage. Nur UCUM-Einheiten sind zulässig.\n\nNicht immer werden Richtgrenzen mit Einheiten angegeben. Ein typisches Bespiel hierfür: zum Immunitätsnachweis aus einer Probe werden Verdünnungsreihen von 1:2, 1:4, 1:8, 1:16, 1:32 usw. hergestellt. Die Verdünnungen gibt man auf Zellkulturen, die dann mit einem Virus infiziert werden. Die höchste Verdünnungsstufe, bei der noch eine Infektion der Zellen vollständig verhindert wird, also noch ausreichend Antikörper vorhanden sind, wird als Titer angegeben. Dieser Titer wird ohne Einheiten angeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.high.system" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.high.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.high.code" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.high.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type" ] ;
       fhir:definition [ fhir:v "Die Typisierung von Richtgrenzen bezieht sich auf die Indikation einer Laboruntersuchung. Beispiele sind:\n\n* Referenzbereich, zur Feststellung oder Ausschluss von Erkrankungen\n* Therapeutischer Bereich, zur Einstellung einer medikamentösen Therapie\n* Zielbereich, zur Kontrolle medizinischer Maßnahmen\n* Perzentilen (z. B. circannuale 2,5-97,5, als 95% eines gesunden Kollektivs)\n* Erwartungsbereiche aufgrund endokrinologischer Konstitution" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding" ] ;
       fhir:definition [ fhir:v "Hier wird der Richtgrenzen-Typ in codierter Form angegeben.\n\nFür die codierte Richtgrenzen-Typisierung wird eine Auswahl von HL7®-Codes als (bevorzugte) Option angeboten. Die Nutzung der hinterlegten Codes ist abhängig vom Kontext." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding.system" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding.version" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding.version" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding.code" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding.display" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding.display" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.coding.userSelected" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.coding.userSelected" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.type.text" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.type.text" ] ;
       fhir:definition [ fhir:v "Hier wird der Richtgrenzen-Typ als Freitext eingegeben." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo" ] ;
       fhir:definition [ fhir:v "Die Ermittlung von \"Normwerten\" basiert üblicherweise auf 95% eines gesunden Erwachsenen-Kollektivs. Normwerte sind Grenzwerte, die sich auf ein „Normalkollektiv“ beziehen. Als Normalkollektiv wird definiert: „gesunde“ PatientInnen ohne erhöhtes Risiko. Es kann spezifische Richtgrenzen für andere Kollektive geben. Mögliche Unterscheidungen sind:\n\n* nach Alter\n* nach klinisch-relevantem Geschlecht (divers, männlich, weiblich)\n* nach Konstitution/Merkmal\n* nach körperlichem Zustand\n\nBeispielsweise:\n\n* Biologisch weiblich (female-typical)\n* Biologisch männlich (male-typical)\n* Weiblich, postmenopausal\n* Erwachsene, männlich, 30-50 Jahre\n* Raucher\n* Kind (Beginn des 4. bis zum vollendeten 12. Lebensjahr)\n\nBei den Angaben zum Kollektiv können mehrere Angaben kombiniert aufgeführt werden. Zusätzlich zur Freitextangabe einer LDT-Information ist in FHIR® auch die Codierung möglich (optional)." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding" ] ;
       fhir:definition [ fhir:v "Hier kann der \"Kollektiv-Bezug\" als codierte Information angegeben werden.\n\nDieses ValueSet mit HL7®-Codes für den Kollektivbezug enthält (eHDSI-konform) bislang nur geschlechtsspezifische Bezüge. Viele weitere, mögliche Kollektivbezüge sind noch nicht standardisiert terminologisch abgebildet." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "example" ] ;
         fhir:valueSet [
           fhir:v "https://fhir.kbv.de/ValueSet/KBV_VS_MIO_LAB_EHDSIReferenceRangeAppliesTo|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/ValueSet/KBV_VS_MIO_LAB_EHDSIReferenceRangeAppliesTo|1.0.0-update>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding.system" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding.version" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding.version" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding.code" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding.display" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding.display" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.coding.userSelected" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.coding.userSelected" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.referenceRange.appliesTo.text" ] ;
       fhir:path [ fhir:v "Observation.referenceRange.appliesTo.text" ] ;
       fhir:definition [ fhir:v "Freitextangabe zum Kollektiv-Bezug der Richtgrenzen" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
