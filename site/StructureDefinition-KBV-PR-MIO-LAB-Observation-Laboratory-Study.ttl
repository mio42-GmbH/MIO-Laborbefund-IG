       fhir:short [ fhir:v "Bezeichnung für Fachbereich, unter dem Laboruntersuchungen gruppiert werden, Inhalt identisch zu Observation_Laboratory_Study_Group.category:studyType" ] ;
       fhir:definition [ fhir:v "Hier kann die fachspezifische Eingrenzung innerhalb der Laboratoriumsmedizin anhand entsprechender Kategorie-Codes angegeben werden. Beispiele für eine fachspezifische Eingrenzung sind: \"Klinische Chemie\", \"Hämatologie\", \"Serologie\", \"Toxikologie\", \"Urindiagnostik\", \"Fertilitätsdiagnostik\". Es besteht auch die Option, eine allgemeine Kategorie für \"Labor\" zu vergeben." ] ;
