         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.focus" ] ;
       fhir:path [ fhir:v "Observation.focus" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.encounter" ] ;
       fhir:path [ fhir:v "Observation.encounter" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.effective[x]" ] ;
       fhir:path [ fhir:v "Observation.effective[x]" ] ;
       fhir:short [ fhir:v "Klinischer Bezugszeitpunkt" ] ;
       fhir:definition [ fhir:v "Der Klinische Bezugszeitpunkt ist wichtig, um die Laboruntersuchung im Zeitverlauf einordnen zu können.\n\nDie Redundanz ist beabsichtigt. Es geht darum, einen Zeitpunkt ermitteln zu können, der für Studien-Statistiken als vergleichsrelevant eingestuft wird. Da im klinischen Alltag nicht sicher gestellt ist, dass grundsätzlich und immer der Zeitpunkt der Materialentnahme auch dokumentiert wird, wurde dieser Algorithmus festgelegt, um die Dokumentation eines statistischen relevanten Zeitpunktes zu garantieren:\n\n* WENN der Entnahmezeitpunkt des Probenmaterials angeben ist, so gilt der Entnahmezeitpunkt;\n* WENN der Sammelzeitraum-bis angegeben ist, so gilt der bis-Zeitpunkt;\n* SONST gilt (hilfsweise) der Laboreingangszeitpunkt: Zeitpunkt des Eingangs der Probe im Labor." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "dateTime"^^xsd:anyURI ]
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "date-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Datetime must be at least day, month and year." ] ;
         fhir:expression [ fhir:v "($this as dateTime).toString().length() >= 10" ] ;
         fhir:source [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.issued" ] ;
       fhir:path [ fhir:v "Observation.issued" ] ;
       fhir:short [ fhir:v "Dokumentationszeitpunkt" ] ;
       fhir:definition [ fhir:v "Zeitstempel oder Zeitangabe zur Dokumentation der einzelnen Laboruntersuchung." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.performer" ] ;
       fhir:path [ fhir:v "Observation.performer" ] ;
       fhir:definition [ fhir:v "Hier wird das durchführende Labor in Bezug auf die einzelne Laboruntersuchung benannt.\n\nZur Beachtung: im Laborgesamtbefund wird das durchführende Labor (als DiagnosticReport.performer) dokumentiert. Für selbst erbrachte Laborleistungen muss aus Gründen der EU-Kompatibilität auch immer zur Einzeluntersuchung das durchführende Labor (Observation.performer) dokumentiert werden, dieses kann aus dem Laborgesamtbefund abgeleitet werden.\n\nWenn das auftragnehmende Labor die einzelne Laboruntersuchung nicht in Eigenleistung erbringt sondern an ein Speziallabor weiterleitet, sogenannte Fremdleistung, muss hier das durchführende sekundäre Labor als durchführendes Labor dokumentiert werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Practitioner|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Practitioner|1.0.0-update>
         ] [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_PractitionerRole|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_PractitionerRole|1.0.0-update>
         ] [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Organization|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Organization|1.0.0-update>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.performer.reference" ] ;
       fhir:path [ fhir:v "Observation.performer.reference" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "type" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:definition [ fhir:v "Messergebnisse können quantitativ oder qualitativ sein." ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Quantity"^^xsd:anyURI ]
       ] [
         fhir:code [ fhir:v "CodeableConcept"^^xsd:anyURI ]
       ] [
         fhir:code [ fhir:v "string"^^xsd:anyURI ]
       ] [
         fhir:code [ fhir:v "Range"^^xsd:anyURI ]
       ] [
         fhir:code [ fhir:v "Ratio"^^xsd:anyURI ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:sliceName [ fhir:v "valueQuantity" ] ;
       fhir:definition [ fhir:v "Hier wird der Ergebniswert als Quantität angegeben." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Quantity"^^xsd:anyURI ]
       ] ) ;
       fhir:pattern [
         a fhir:Quantity ;
         fhir:system [ fhir:v "http://unitsofmeasure.org"^^xsd:anyURI ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity.value" ] ;
       fhir:path [ fhir:v "Observation.value[x].value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity.comparator" ] ;
       fhir:path [ fhir:v "Observation.value[x].comparator" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity.unit" ] ;
       fhir:path [ fhir:v "Observation.value[x].unit" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity.system" ] ;
       fhir:path [ fhir:v "Observation.value[x].system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueQuantity.code" ] ;
       fhir:path [ fhir:v "Observation.value[x].code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept" ] ;
       fhir:path [ fhir:v "Observation.value[x]" ] ;
       fhir:sliceName [ fhir:v "valueCodeableConcept" ] ;
       fhir:short [ fhir:v "Qualitatives Messergebnis (z.B. nominal oder ordinal)" ] ;
       fhir:definition [ fhir:v "Qualitative Messergebnisse sind - je nach Messgröße oder Skalierung:\n\nOrdinal, d.h. numerische, in der Regel ganzzahlige Ordnungswerte, die den Vergleich (z. B. kleiner als, größer als) ermöglichen oder zur Vergabe einer Punktebewertung (\"Benotung\") herangezogen werden, beispielsweise eine Schmerzskala (z.B. von 1 bis 10)\n\nNominal, d.h. Festwerte ohne Rangordnung, beispielsweise in der Mikrobiologie: Krankheitserreger (z.B. Escherichia Coli; Staphylococcus aureus als Bezeichner oder als Code.) oder Angabe zum Nachweis (z.B. vorhanden / nicht vorhanden)." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "CodeableConcept"^^xsd:anyURI ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept.coding" ] ;
       fhir:path [ fhir:v "Observation.value[x].coding" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:definition [ fhir:v "Qualitatives Messergebnis in codierter Form." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept.coding.system" ] ;
       fhir:path [ fhir:v "Observation.value[x].coding.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept.coding.code" ] ;
       fhir:path [ fhir:v "Observation.value[x].coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept.coding.display" ] ;
       fhir:path [ fhir:v "Observation.value[x].coding.display" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Observation.value[x]:valueCodeableConcept.coding:snomed" ] ;
