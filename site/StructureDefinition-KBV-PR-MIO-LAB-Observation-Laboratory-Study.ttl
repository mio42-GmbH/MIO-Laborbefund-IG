       fhir:ElementDefinition.short [ fhir:value "Laboranalysegerät" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Hier wird das Gerät bzw. Medizinprodukt referenziert, mit dem die Laboruntersuchung durchgeführt wird." ] ;
