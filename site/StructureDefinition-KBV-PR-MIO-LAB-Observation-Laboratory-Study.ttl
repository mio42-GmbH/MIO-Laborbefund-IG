       fhir:sliceName [ fhir:v "data-absent-reason" ] ;
       fhir:short [ fhir:v "Grund für das Nichtvorhandensein eines LOINC®-Codes" ] ;
       fhir:definition [ fhir:v "Begründung für die Nicht-Vergabe eines LOINC®-Codes zur Laboruntersuchung" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "http://hl7.org/fhir/StructureDefinition/data-absent-reason|5.3.0"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/data-absent-reason|5.3.0>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.extension:data-absent-reason.value[x]" ] ;
       fhir:path [ fhir:v "Observation.code.extension.value[x]" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "https://fhir.kbv.de/ValueSet/KBV_VS_MIO_LAB_Data_Absent_Reason|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/ValueSet/KBV_VS_MIO_LAB_Data_Absent_Reason|1.0.0-update>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding" ] ;
       fhir:path [ fhir:v "Observation.code.coding" ] ;
       fhir:definition [ fhir:v "In diesem Element wird ein LOINC®-Code für die Laboruntersuchung angegeben, inklusive Anzeigename (Display Name) sowie Name und Version des Codesystems.\n\nDie Angabe des LOINC®-Codes ist verbindlich. Falls dies nicht möglich ist, muss der Grund für das Nichtvorhandensein eines Codes (DataAbsentReason) angegeben werden." ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:Coding ;
         fhir:system [ fhir:v "http://loinc.org"^^xsd:anyURI ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding.system" ] ;
       fhir:path [ fhir:v "Observation.code.coding.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding.version" ] ;
       fhir:path [ fhir:v "Observation.code.coding.version" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding.code" ] ;
       fhir:path [ fhir:v "Observation.code.coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding.display" ] ;
       fhir:path [ fhir:v "Observation.code.coding.display" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.coding.userSelected" ] ;
       fhir:path [ fhir:v "Observation.code.coding.userSelected" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.code.text" ] ;
       fhir:path [ fhir:v "Observation.code.text" ] ;
       fhir:short [ fhir:v "Verwender-spezifische (vom Long Common Name des LOINC®-Codes ggf. abweichende) Bezeichnung für die Laboruntersuchung" ] ;
       fhir:definition [ fhir:v "Die Freitext-Bezeichnung erlaubt es, in den verwendenden/verarbeitenden Systemen den Einrichtungs-spezifischen bzw. Verwender-spezifischen Bezeichner für eine Laboruntersuchung weiterhin zu verwenden.\n\nFür den Fall, dass anstelle des LOINC®-Codes ein Grund für das Nichtvorhandensein eines Codes (DataAbsentReason) vergeben wird, muss die Freitext-Bezeichnung befüllt sein." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.subject" ] ;
       fhir:path [ fhir:v "Observation.subject" ] ;
       fhir:short [ fhir:v "Zu behandelnde Person" ] ;
       fhir:definition [ fhir:v "Hier wird die zu behandelnde Person referenziert." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
