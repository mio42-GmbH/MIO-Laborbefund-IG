       fhir:short [ fhir:v "Bezeichnung für fachlich-medizinischen Bezug, unter dem Laboruntersuchungen gruppiert werden, Inhalt identisch zu Observation_Laboratory_Study_Group.category:testProfile" ] ;
       fhir:definition [ fhir:v "Unter Test-Profil werden zusammengehörige Labortests oder eine Gruppe von Einzeluntersuchungen aus einem Verfahren zusammengefasst." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
