         ] ) ;
         fhir:rules [ fhir:v "closed" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.extension:externalService" ] ;
       fhir:path [ fhir:v "Observation.extension" ] ;
       fhir:sliceName [ fhir:v "externalService" ] ;
       fhir:short [ fhir:v "Kennzeichen Fremdleistung" ] ;
       fhir:definition [ fhir:v "Dieses Kennzeichen wird gesetzt, wenn die Laboruntersuchung von einem anderen Labor durchgeführt wird." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_External_Service"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_External_Service>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
