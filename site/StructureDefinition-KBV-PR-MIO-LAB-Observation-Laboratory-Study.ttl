       fhir:id [ fhir:v "Observation.status" ] ;
       fhir:path [ fhir:v "Observation.status" ] ;
       fhir:definition [ fhir:v "Bearbeitungsstatus der einzelnen Laboruntersuchung. Die Status-Werte orientieren sich an HL7® FHIR® Version 4.0.1, jedoch wurde der Wert \"unknown\" aufgrund von Nichtverwendung herausgenommen." ] ;
