       fhir:sliceName [ fhir:v "valueString" ] ;
       fhir:short [ fhir:v "Ergebnis uncodiert in Textform" ] ;
       fhir:definition [ fhir:v "Textergebnis als Freitext. Dieses Feld ist für Beobachtungen vorgesehen, bei denen für das Resultat keine numerischen oder codierten Werte benötigt werden. Beispiele sind qualitative Beschreibungen oder freitextliche Kommentare." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
