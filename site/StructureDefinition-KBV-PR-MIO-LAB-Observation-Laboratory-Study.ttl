       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.subject.identifier" ] ;
       fhir:path [ fhir:v "Observation.subject.identifier" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Identifier"^^xsd:anyURI ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/identifier-kvid-10"^^xsd:anyURI ;
