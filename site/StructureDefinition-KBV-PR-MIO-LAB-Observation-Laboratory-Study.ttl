     ], [
       fhir:index 257 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.low" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.low" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Die untere Richtgrenze ist eine quantitative Grenze. Datentyp und Einheit entsprechen denen beim quantitativen Messergebnis. Unter Eigenschaften sind mögliche Werte gelistet, die in dieses Feld hineinpassen könnten, beispielsweise ein Grenzwert aus dem LDT. Bei diesen Beispielen aus dem LDT gilt es zu beachten, dass die Grenzwerte nur für eine Richtgrenze vom Typ \"normal\" gelten.\n\nDisclaimer: FHIR® definiert aktuell nur inklusive Richtgrenzen. Für die Praxistauglichkeit besteht aber die Anforderung, auch exklusive Richtgrenzen abbilden zu können. Diese Thematik wurde schon bei HL7® FHIR® platziert, es gibt aber noch keine abschließende Festlegung dazu. Im Informationsmodell sind beide Optionen bereits dargestellt, um diese Anforderung sichtbar zu machen." ] ;
       fhir:ElementDefinition.patternQuantity [
         fhir:Quantity.system [ fhir:value "http://unitsofmeasure.org" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 258 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.low.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.low.value" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Numerischer Wert für eine gemessene Größe, eine Zahl mit optionalen Dezimalstellen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 259 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.low.unit" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.low.unit" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Die Einheit leitet sich aus der Messgröße (gemessene Eigenschaft und Mengenmaß) ab. Ein Beispiel: Wenn die Messgröße \"Massekonzentration pro Volumen\" ist, kommen als Einheiten mg/dl oder g/dl in Frage. Nur UCUM-Einheiten sind zulässig.\n\nNicht immer werden Richtgrenzen mit Einheiten angegeben. Ein typisches Bespiel hierfür: zum Immunitätsnachweis aus einer Probe werden Verdünnungsreihen von 1:2, 1:4, 1:8, 1:16, 1:32 usw. hergestellt. Die Verdünnungen gibt man auf Zellkulturen, die dann mit einem Virus infiziert werden. Die höchste Verdünnungsstufe, bei der noch eine Infektion der Zellen vollständig verhindert wird, also noch ausreichend Antikörper vorhanden sind, wird als Titer angegeben. Dieser Titer wird ohne Einheiten angeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 260 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.low.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.low.system" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 261 ;
