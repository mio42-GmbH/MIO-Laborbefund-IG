     ] [
       fhir:id [ fhir:v "Observation.code" ] ;
       fhir:path [ fhir:v "Observation.code" ] ;
       fhir:definition [ fhir:v "Hier wird die konkrete einzelne Laboruntersuchung spezifiziert." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.code.extension:data-absent-reason" ] ;
