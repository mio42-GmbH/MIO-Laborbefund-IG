     ] [
       fhir:id [ fhir:v "Observation.extension:accreditedService" ] ;
       fhir:path [ fhir:v "Observation.extension" ] ;
       fhir:sliceName [ fhir:v "accreditedService" ] ;
       fhir:short [ fhir:v "Kennzeichen Akkreditierte Laboruntersuchung" ] ;
       fhir:definition [ fhir:v "Diese Angabe betrifft akkreditierte Labore. Basierend auf der Akkreditierung ist gefordert, dass nicht akkreditierte Leistungen gekennzeichnet werden, auch im Laborbefund." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
