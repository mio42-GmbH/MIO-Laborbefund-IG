       fhir:short [ fhir:v "Kennzeichen Verbundleistung" ] ;
       fhir:definition [ fhir:v "Dieses Kennzeichen wird gesetzt, wenn die \"Fremdleistung\" von einem anderen Labor aus dem eigenen Verbund durchgeführt wird und diese Information aus administrativen Gründen zusätzlich benötigt wird." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Extension"^^xsd:anyURI ] ;
