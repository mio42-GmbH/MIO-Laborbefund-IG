       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 263 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.high.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.high.value" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Numerischer Wert für eine gemessene Größe, eine Zahl mit optionalen Dezimalstellen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 264 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.high.unit" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.high.unit" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Die Einheit leitet sich aus der Messgröße (gemessene Eigenschaft und Mengenmaß) ab. Ein Beispiel: Wenn die Messgröße \"Massekonzentration pro Volumen\" ist, kommen als Einheiten mg/dl oder g/dl in Frage. Nur UCUM-Einheiten sind zulässig.\n\nNicht immer werden Richtgrenzen mit Einheiten angegeben. Ein typisches Bespiel hierfür: zum Immunitätsnachweis aus einer Probe werden Verdünnungsreihen von 1:2, 1:4, 1:8, 1:16, 1:32 usw. hergestellt. Die Verdünnungen gibt man auf Zellkulturen, die dann mit einem Virus infiziert werden. Die höchste Verdünnungsstufe, bei der noch eine Infektion der Zellen vollständig verhindert wird, also noch ausreichend Antikörper vorhanden sind, wird als Titer angegeben. Dieser Titer wird ohne Einheiten angeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 265 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.high.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.high.system" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 266 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.high.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.high.code" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 267 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Die Typisierung von Richtgrenzen bezieht sich auf die Indikation einer Laboruntersuchung. Beispiele sind:\n\n* Referenzbereich, zur Feststellung oder Ausschluss von Erkrankungen\n* Therapeutischer Bereich, zur Einstellung einer medikamentösen Therapie\n* Zielbereich, zur Kontrolle medizinischer Maßnahmen\n* Perzentilen (z. B. circannuale 2,5-97,5, als 95% eines gesunden Kollektivs)\n* Erwartungsbereiche aufgrund endokrinologischer Konstitution" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 268 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Hier wird der Richtgrenzen-Typ in codierter Form angegeben.\n\nFür die codierte Richtgrenzen-Typisierung wird eine Auswahl von HL7®-Codes als (bevorzugte) Option angeboten. Die Nutzung der hinterlegten Codes ist abhängig vom Kontext." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 269 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding.system" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 270 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding.version" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding.version" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 271 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding.code" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 272 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding.display" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 273 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.coding.userSelected" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.coding.userSelected" ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index 274 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.type.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.type.text" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Hier wird der Richtgrenzen-Typ als Freitext eingegeben." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 275 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.appliesTo" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.appliesTo" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Die Ermittlung von \"Normwerten\" basiert üblicherweise auf 95% eines gesunden Erwachsenen-Kollektivs. Normwerte sind Grenzwerte, die sich auf ein „Normalkollektiv“ beziehen. Als Normalkollektiv wird definiert: „gesunde“ PatientInnen ohne erhöhtes Risiko. Es kann spezifische Richtgrenzen für andere Kollektive geben. Mögliche Unterscheidungen sind:\n\n* nach Alter\n* nach klinisch-relevantem Geschlecht (divers, männlich, weiblich)\n* nach Konstitution/Merkmal\n* nach körperlichem Zustand\n\nBeispielsweise:\n\n* Biologisch weiblich (female-typical)\n* Biologisch männlich (male-typical)\n* Weiblich, postmenopausal\n* Erwachsene, männlich, 30-50 Jahre\n* Raucher\n* Kind (Beginn des 4. bis zum vollendeten 12. Lebensjahr)\n\nBei den Angaben zum Kollektiv können mehrere Angaben kombiniert aufgeführt werden. Zusätzlich zur Freitextangabe einer LDT-Information ist in FHIR® auch die Codierung möglich (optional)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 276 ;
