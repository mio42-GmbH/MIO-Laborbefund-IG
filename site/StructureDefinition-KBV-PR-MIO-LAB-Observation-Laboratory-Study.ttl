     ], [
       fhir:index 245 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Richtgrenzen oder Bewertungsgrenzen zu einer Laboruntersuchung\n\n* werden herangezogen für die Beurteilung und Einordnung von Messergebnissen\n* sind laborärztliche Entscheidungsgrenzen (mit ggf. juristischer Relevanz)\n* sind ärztliche Entscheidungshilfen im klinischen Allta\n\n\nDisclaimer: FHIR® definiert aktuell nur inklusive Richtgrenzen. Für die Praxistauglichkeit besteht aber die Anforderung, auch exklusive Richtgrenzen abbilden zu können. Diese Thematik wurde schon bei HL7® FHIR® platziert, es gibt aber noch keine abschließende Festlegung dazu. Im Informationsmodell sind beide Optionen bereits dargestellt, um diese Anforderung sichtbar zu machen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 246 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "closed" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 247 ;
       fhir:Element.id [ fhir:value "Observation.referenceRange.extension:sourceReferenceRange" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.referenceRange.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "sourceReferenceRange" ] ;
       fhir:ElementDefinition.short [ fhir:value "Quelle der Richtgrenzen" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Mögliche Angaben als Quelle für Richtgrenzen können sein:\n\n* Internationaler Standard\n* Nationaler Standard\n* Literatur\n* Gerätehersteller\n* Beipackzettel\n* Labor-intern\n* nicht angegeben\n\nZusätzlich zur Freitextangabe einer LDT-Information ist in FHIR® auch die Codierung möglich (optional)." ] ;
