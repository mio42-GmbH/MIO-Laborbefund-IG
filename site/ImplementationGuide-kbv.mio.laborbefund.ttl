       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "KBV_PR_MIO_LAB_DiagnosticReport" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Profil für den Laborgesamtbefund (DiagnosticReport). Darin verschachtelt unter \"Ergebnisse\" (DiagnosticReport.result) ist die Referenz auf \"Untersuchungsgruppe\" (Observation_Laboratory_Study_Group), darin die Referenz auf \"Laboruntersuchung\" (Observation_Laboratory_Study), darin die Referenz auf \"Probe\" (Specimen)." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
