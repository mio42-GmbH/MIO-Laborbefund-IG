       ] ;
       fhir:name [ fhir:v "KBV_PR_MIO_LAB_Composition" ] ;
       fhir:description [ fhir:v "Dieses Profil bündelt die Strukturen, die zum gesamten Laborbefund gehören. Das MIO Laborbefund enthält genau einen Laborgesamtbefund, inklusive aller Befundanteile und Anhänge." ] ;
