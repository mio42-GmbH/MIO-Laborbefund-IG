       fhir:name [ fhir:v "KBV_PR_MIO_LAB_BodyStructure" ] ;
       fhir:description [ fhir:v "Dieses Profil bildet eine Körperstruktur ab.\n\n\nAngaben zur Körperstruktur können enthalten:\n\n* Körperstelle (anatomische Benennung)\n* Lateralität (für paarige Organe/Strukturen: rechts, links, beidseits)\n* Lokalisierung (für räumliche Angaben, z.B. oben, unten)\n* Uhrzeigerposition (z.B. 12-Uhr-Position)\n* Morphologie (z.B. pathologische Strukturen)" ] ;
       fhir:example [
         a fhir:boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [ fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ] ;
         fhir:value [
           a fhir:string ;
