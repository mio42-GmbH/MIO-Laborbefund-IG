     ], [
       fhir:index 73 ;
       fhir:Element.id [ fhir:value "ServiceRequest.reasonCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.reasonCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Prozessualer Anlass oder medizinischer Veranlassungsgrund der Labordiagnostik" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Der Anlass der Labordiagnostik wird als prozessuale Fragestellung formuliert. Diese Angabe dient der Fokussierung der Beurteilung. Beispiele für Inhalte aus dem LDT, die in dieses Freitextfeld hineinpassen könnten, sind: Ausschluss; Verlaufskontrolle; Vorsorge.\n\n\nDer Veranlassungsgrund der Labordiagnostik wird als medizinische Fragestellung formuliert. Diese Angabe dient der fachlichen Präzision der Beurteilung. Beispiele für Inhalte aus dem LDT, die in dieses Freitextfeld hineinpassen könnten, sind: Eingriff; Infektion; Rheuma; Tumor.\n\n\nZusätzlich zur Freitextangabe einer LDT-Information ist in FHIR® auch die Codierung möglich." ] ;
       fhir:ElementDefinition.max [ fhir:value "2" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 74 ;
       fhir:Element.id [ fhir:value "ServiceRequest.reasonCode.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.reasonCode.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.description [ fhir:value "Extensions are always sliced by (at least) url" ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "closed" ]
       ] ;
