       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.reasonCode.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "reasonType" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Hier wird unterschieden, ob es sich bei der Angabe um einen Anlass und Veranlassungsgrund des Laborauftrags handelt." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
