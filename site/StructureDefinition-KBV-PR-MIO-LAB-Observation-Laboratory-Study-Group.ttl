       ] )
     ] )
  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Observation" ] ;
       fhir:path [ fhir:v "Observation" ] ;
       fhir:definition [ fhir:v "Dieses Profil bildet eine Untersuchungsgruppe ab.\n\nUntersuchungsgruppen sind ein technisches Mittel, um fachlich zusammengehörige Laborergebnisse innerhalb des Laborgesamtbefundes gruppiert und sortiert anzuordnen. Die Struktur \"Laborgesamtbefund/Ergebnisse\" enthält mindestens eine Struktur \"Untersuchungsgruppe\" im Abschnitt Ergebnisse.\n\nFür die gruppierte Darstellung von Laboruntersuchungen können (optional) aus den fachlichen Gruppierungsmerkmalen fachliche Bezeichner als Gruppenüberschrift abgeleitet werden.\n\nUntersuchungsgruppen, deren Sortierreihenfolge und die Sortierreihenfolge der einzelnen Untersuchungen innerhalb einer Gruppe werden Labor-intern definiert. Das empfangende System muss diese Gruppierungen und Sortierungen interpretieren können. Diese Strukturierung dient dem Erhalt des fachlichen Kontextes von digital kommunizierten Laboruntersuchungen." ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "eu-lab-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "If observation status is other then \"registered\" or \"cancelled\", at least one of these Observation elements shall be provided:  \"value\", \"dataAbsentReason\", \"hasMember\" or \"component\"" ] ;
         fhir:expression [ fhir:v "(status in ('registered'|'cancelled')) or value.exists() or hasMember.exists() or component.exists() or dataAbsentReason.exists()" ] ;
         fhir:source [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study_Group"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study_Group>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "Observation.meta" ] ;
       fhir:path [ fhir:v "Observation.meta" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.meta.id" ] ;
       fhir:path [ fhir:v "Observation.meta.id" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.meta.versionId" ] ;
       fhir:path [ fhir:v "Observation.meta.versionId" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "Observation.meta.lastUpdated" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.meta.source" ] ;
       fhir:path [ fhir:v "Observation.meta.source" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.implicitRules" ] ;
       fhir:path [ fhir:v "Observation.implicitRules" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.language" ] ;
       fhir:path [ fhir:v "Observation.language" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.text.status" ] ;
       fhir:path [ fhir:v "Observation.text.status" ] ;
       fhir:pattern [
         a fhir:code ;
         fhir:v "extensions"
       ]
     ] [
       fhir:id [ fhir:v "Observation.contained" ] ;
       fhir:path [ fhir:v "Observation.contained" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.identifier" ] ;
       fhir:path [ fhir:v "Observation.identifier" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.basedOn" ] ;
       fhir:path [ fhir:v "Observation.basedOn" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.partOf" ] ;
       fhir:path [ fhir:v "Observation.partOf" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Observation.status" ] ;
       fhir:path [ fhir:v "Observation.status" ] ;
       fhir:pattern [
         a fhir:code ;
         fhir:v "final"
       ]
     ] [
       fhir:id [ fhir:v "Observation.category" ] ;
       fhir:path [ fhir:v "Observation.category" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "extension.value" ]
         ] ) ;
         fhir:rules [ fhir:v "closed" ]
       ] ;
       fhir:short [ fhir:v "Fachliche Bezeichnung für eine Untersuchungsgruppe" ] ;
       fhir:definition [ fhir:v "Zur jeweiligen Gruppe kann es (optional) gruppenbezogene fachliche Bezeichner geben, abgebildet in der vorliegenden Struktur \"Fachliches Gruppierungsmerkmal\". Für die gruppierte Darstellung von Laborergebnissen im Laborgesamtbefund können solche fachlichen Gruppierungsmerkmale als Gruppenüberschrift dienen. Mögliche Gruppenüberschriften sind:\n\n  * \"Laborbereich\" (z.B. Klinische Chemie)\n  * \"Test-Profil\" (z.B. \"Gerinnungsstatus\")\n  * \"Laborbereich\" mit \"Test-Profil\" kombiniert" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "3" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Observation.category:laboratory" ] ;
       fhir:path [ fhir:v "Observation.category" ] ;
       fhir:sliceName [ fhir:v "laboratory" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
