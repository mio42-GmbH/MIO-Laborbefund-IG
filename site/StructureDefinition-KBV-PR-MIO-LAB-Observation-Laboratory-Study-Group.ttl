         fhir:valueSet [
           fhir:v "http://hl7.org/fhir/ValueSet/observation-interpretation|4.0.1"^^xsd:anyURI ;
           fhir:link <http://hl7.org/fhir/ValueSet/observation-interpretation|4.0.1>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "sct-concept" ] ;
         fhir:map [ fhir:v "< 260245000 |Findings values|" ]
       ] [
