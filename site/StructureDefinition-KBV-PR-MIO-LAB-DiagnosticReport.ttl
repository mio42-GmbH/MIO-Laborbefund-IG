       fhir:ElementDefinition.short [ fhir:value "Manuell gesetztes Kennzeichen Kritischer Befund" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Dieses Kennzeichen ist optional und deklariert einen aus labormedizinischer Sicht medizinisch kritischen Befund. Es wird aus einer aktiven Entscheidung des/der Labormediziners/in manuell gesetzt." ] ;
