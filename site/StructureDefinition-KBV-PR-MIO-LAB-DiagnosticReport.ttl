         fhir:ElementDefinition.constraint.key [ fhir:value "diag-status-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "A secondary status can only be provided if the diagnostic report status is either \"partial\" or \"preliminary\"." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "status in ('registered'|'final'|'cancelled'|'entered-in-error') implies extension('https://fhir.kbv.de/StructureDefinition/KBV_EX_MIO_LAB_Secondary_Status').empty()" ] ;
