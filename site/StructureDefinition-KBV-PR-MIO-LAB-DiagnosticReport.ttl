       fhir:ElementDefinition.definition [ fhir:value "Hier wird die UUID eingetragen. Der String beginnt immer mit \"urn:uuid:\", der zusammengesetzte String sähe dann beispielsweise so aus: \"urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6\"." ] ;
