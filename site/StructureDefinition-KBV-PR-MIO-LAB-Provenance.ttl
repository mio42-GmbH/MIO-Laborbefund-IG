       fhir:path [ fhir:v "Provenance.text.status" ] ;
       fhir:pattern [
         a fhir:code ;
         fhir:v "extensions"
       ]
     ] [
       fhir:id [ fhir:v "Provenance.contained" ] ;
       fhir:path [ fhir:v "Provenance.contained" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.target" ] ;
       fhir:path [ fhir:v "Provenance.target" ] ;
       fhir:definition [ fhir:v "Hier wird die Laboruntersuchung referenziert, auf die sich die medizinische Freigabe bezieht." ] ;
       fhir:type ( [
         fhir:code [ fhir:v "Reference"^^xsd:anyURI ] ;
         fhir:targetProfile ( [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study|1.0.0-update"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Observation_Laboratory_Study|1.0.0-update>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.target.reference" ] ;
       fhir:path [ fhir:v "Provenance.target.reference" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.target.type" ] ;
       fhir:path [ fhir:v "Provenance.target.type" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.target.identifier" ] ;
       fhir:path [ fhir:v "Provenance.target.identifier" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.target.display" ] ;
       fhir:path [ fhir:v "Provenance.target.display" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.occurred[x]" ] ;
       fhir:path [ fhir:v "Provenance.occurred[x]" ] ;
       fhir:definition [ fhir:v "Der Zeitpunkt, wenn Ergebnis als \"medizinisch qualitätsgesichert bzw. bewertet\" in das Laborinformationssystem übernommen wird.\n\nIm Laborkontext sollte der Zeitpunkt nach Möglichkeit minutengenau angegeben werden, die Mindestangabe ist tagesgenau." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:type ( [
         fhir:code [ fhir:v "dateTime"^^xsd:anyURI ]
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "date-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Datetime must be at least day, month and year." ] ;
         fhir:expression [ fhir:v "($this as dateTime).toString().length() >= 10" ] ;
         fhir:source [
           fhir:v "https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Provenance"^^xsd:anyURI ;
           fhir:link <https://fhir.kbv.de/StructureDefinition/KBV_PR_MIO_LAB_Provenance>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.recorded" ] ;
       fhir:path [ fhir:v "Provenance.recorded" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.policy" ] ;
       fhir:path [ fhir:v "Provenance.policy" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.location" ] ;
       fhir:path [ fhir:v "Provenance.location" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
