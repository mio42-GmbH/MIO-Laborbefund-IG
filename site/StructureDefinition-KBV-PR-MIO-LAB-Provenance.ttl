  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Provenance" ] ;
       fhir:path [ fhir:v "Provenance" ] ;
       fhir:definition [ fhir:v "Hier werden Angaben zur medizinischen Freigabe der Laboruntersuchung gemacht. Das beinhaltet die Angabe der freigebenden Person, des Zeitpunktes und der Typisierung der Freigabe." ]
     ] [
       fhir:id [ fhir:v "Provenance.meta" ] ;
       fhir:path [ fhir:v "Provenance.meta" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.meta.id" ] ;
       fhir:path [ fhir:v "Provenance.meta.id" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.meta.versionId" ] ;
       fhir:path [ fhir:v "Provenance.meta.versionId" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "Provenance.meta.lastUpdated" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Provenance.meta.source" ] ;
       fhir:path [ fhir:v "Provenance.meta.source" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Provenance.implicitRules" ] ;
       fhir:path [ fhir:v "Provenance.implicitRules" ] ;
